;
; DriverLevelInputSimulatorDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = DriverLevelInputSimulatorDriver.cat
DriverVer   =
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
DriverLevelInputSimulatorDriver.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DeviceDescription% = DriverLevelInputSimulatorDriver_Device, Root\DriverLevelInputSimulator

[DriverLevelInputSimulatorDriver_Device.NT]
CopyFiles = DriverCopyFiles

[DriverCopyFiles]
DriverLevelInputSimulatorDriver.sys

[DriverLevelInputSimulatorDriver_Device.NT.HW]
AddReg = DriverLevelInputSimulatorDriver_Device_AddReg

[DriverLevelInputSimulatorDriver_Device_AddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[DriverLevelInputSimulatorDriver_Device.NT.Services]
AddService = DriverLevelInputSimulatorDriver,0x00000002,DriverLevelInputSimulatorDriver_Service

[DriverLevelInputSimulatorDriver_Service]
DisplayName   = %ServiceDescription%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\DriverLevelInputSimulatorDriver.sys

[DriverLevelInputSimulatorDriver_Device.NT.Wdf]
KmdfService = DriverLevelInputSimulatorDriver,DriverLevelInputSimulatorDriver_Wdf

[DriverLevelInputSimulatorDriver_Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ManufacturerName = "Generic Input Device"
DiskName = "Generic Virtual Input Device Installation Media"
DeviceDescription = "Generic Virtual Input Device"
ServiceDescription = "Generic Virtual Input Device Driver"